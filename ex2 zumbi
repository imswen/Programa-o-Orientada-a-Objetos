public class Zumbi
{
    double vida;
    String nome;

    void mostrarVida()
    {
        System.out.println("Vida do "+nome+": "+vida);
    }

    void transfereVida(Zumbi zumbiAlvo, double quantia)
    {
        vida -= quantia;
        zumbiAlvo.vida += quantia;
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Zumbi zumbi = new Zumbi();
        Zumbi zumbi1 = new Zumbi();

        zumbi.nome = "Gui";
        zumbi1.nome = "Leo";
        
        zumbi.vida = 20;
        zumbi1.vida = 20;
        
        zumbi.transfereVida(zumbi1, 10);

        zumbi.mostrarVida();
        zumbi1.mostrarVida();
    }
}

