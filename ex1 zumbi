public class Zumbi
{
    String nome;
    int vida;

    void Grunir()
    {
        System.out.println(nome+": GRRRRR");
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Zumbi zumbi = new Zumbi();
        Zumbi zumbi1 = new Zumbi();

        zumbi.nome = "Gui";
        zumbi1.nome = "Leo";

        zumbi.vida = 20;
        zumbi1.vida = 20;

        zumbi.Grunir();
        zumbi1.Grunir();
    }
}
